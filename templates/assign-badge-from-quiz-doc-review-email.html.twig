{#
/**
 * @file
 * HTML email body for a documentation review request sent to staff.
 *
 * Available variables:
 *   tool            — badge / tool name (string)
 *   member_name     — submitter display name (string)
 *   member_url      — absolute URL to the submitter's Drupal account, or empty
 *   experience      — the member's stated experience (string)
 *   file_links      — list of {url, label} for uploaded documentation files
 *   submission_url  — absolute URL to open the submission in Drupal
 *   submitted_at    — formatted submission time (string)
 *   action_links    — list of {url, label, color} confirm-page buttons
 */
#}
<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #222; max-width: 640px;">
  <h2 style="margin:0 0 8px;">Documentation review: {{ tool }}</h2>

  <table style="border-collapse:collapse;margin:0 0 16px;font-size:14px;">
    <tr>
      <td style="padding:4px 12px 4px 0;color:#666;">Member</td>
      <td>
        {% if member_url %}<a href="{{ member_url }}">{{ member_name }}</a>{% else %}{{ member_name }}{% endif %}
      </td>
    </tr>
    {% if submitted_at %}
      <tr><td style="padding:4px 12px 4px 0;color:#666;">Submitted</td><td>{{ submitted_at }}</td></tr>
    {% endif %}
  </table>

  {% if experience %}
    <p style="margin:0 0 8px;"><strong>Stated experience</strong></p>
    <div style="margin:0 0 16px;padding:12px;background:#f7f7f7;border-left:3px solid #ccc;white-space:pre-wrap;">{{ experience }}</div>
  {% endif %}

  {% if file_links %}
    <p style="margin:0 0 6px;"><strong>Uploaded documentation</strong></p>
    <ul style="margin:0 0 16px;padding-left:20px;">
      {% for f in file_links %}
        <li><a href="{{ f.url }}">{{ f.label }}</a></li>
      {% endfor %}
    </ul>
  {% endif %}

  <div style="margin:24px 0;padding:16px;background:#f5f5f5;border-radius:4px;">
    <p style="margin:0 0 12px;font-weight:bold;font-size:14px;">Review</p>
    {% for link in action_links %}
      <a href="{{ link.url }}"
         style="display:inline-block;padding:10px 16px;margin:4px 6px 4px 0;background:{{ link.color }};color:#fff;text-decoration:none;border-radius:4px;font-size:14px;">
        {{ link.label }}
      </a>
    {% endfor %}
    {% if submission_url %}
      <div style="margin-top:8px;">
        <a href="{{ submission_url }}"
           style="display:inline-block;padding:8px 14px;margin:4px 6px 4px 0;background:#444;color:#fff;text-decoration:none;border-radius:4px;font-size:13px;">
          Open submission in Drupal
        </a>
      </div>
    {% endif %}
  </div>

  <p style="font-size:12px;color:#888;margin-top:24px;">
    Approve / Reject open a confirmation page and don't require login. Links are good for 30 days.
    Approving emails the member their next step automatically.
  </p>
</div>
